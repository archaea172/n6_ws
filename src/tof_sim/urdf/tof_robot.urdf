<?xml version="1.0"?>
<robot name="tof_robot">
  <material name="base_dark">
    <color rgba="0.18 0.20 0.22 1.0"/>
  </material>

  <material name="tof_green">
    <color rgba="0.10 0.70 0.42 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia
        ixx="0.0279"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0279"
        iyz="0.0"
        izz="0.0486"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.12"/>
      </geometry>
      <material name="base_dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.12"/>
      </geometry>
    </collision>
  </link>

  <link name="tof_sensor_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia
        ixx="0.000004"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000006"
        iyz="0.0"
        izz="0.000008"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.025 0.012"/>
      </geometry>
      <material name="tof_green"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.025 0.012"/>
      </geometry>
    </collision>
  </link>

  <!-- +X is the sensing direction. Positive pitch tilts the sensor downward. -->
  <joint name="tof_sensor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tof_sensor_link"/>
    <origin xyz="0.17 0 0.14" rpy="0 0.261799 0"/>
  </joint>

  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="tof_sensor_link">
    <material>Gazebo/Green</material>

    <sensor name="tof_array" type="gpu_ray">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>15</update_rate>

      <ray>
        <scan>
          <horizontal>
            <samples>8</samples>
            <resolution>1</resolution>
            <min_angle>-0.389</min_angle>
            <max_angle>0.389</max_angle>
          </horizontal>
          <vertical>
            <samples>8</samples>
            <resolution>1</resolution>
            <min_angle>-0.389</min_angle>
            <max_angle>0.389</max_angle>
          </vertical>
        </scan>

        <range>
          <min>0.05</min>
          <max>4.0</max>
          <resolution>0.001</resolution>
        </range>

        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>

      <plugin name="tof_array_ros" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/tof_sim</namespace>
          <remapping>~/out:=tof/points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>tof_sensor_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
